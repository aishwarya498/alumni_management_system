# Copy this file to .env and fill in your values

# Database configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=yourpassword
DB_NAME=alumni_db
DB_PORT=3306

# JWT configuration
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRY=7d

# Set to 'development' or 'production'
NODE_ENV=development
